# ══════════════════════════════════════════════════════════════════
#  FTW-KLOC-KILLER — .env.example
#  Copy to .env and fill in. Never commit .env. Pirates keep secrets.
# ══════════════════════════════════════════════════════════════════

# LLM API keys (only needed for T1-T3 — T0 is free, landlubber)
ANTHROPIC_API_KEY=sk-ant-...
OPENAI_API_KEY=sk-...           # optional; only for OpenAI fallback

# Qdrant vector DB (spun up by docker-compose)
QDRANT_URL=http://localhost:6333
QDRANT_COLLECTION=kloc_killer_chunks

# BALANCER tier ceiling — 0=local only, 1=cheap, 2=mid, 3=full
# Set to 0 to run fully offline. Default: 2
ACTIVE_TIER_MAX=2

# BALANCER quality floor — auto-escalate if RQS-L1 drops below this
QUALITY_FLOOR=0.85

# Embeddings provider — "local" (sentence-transformers) or "openai"
EMBEDDING_PROVIDER=local

# Paths
INB_CONFIG_PATH=src/inb_config.json
STATE_STORE_PATH=bus/audit/state.json
BUS_QUEUE_DIR=bus/queues
DECISION_LOG_PATH=bus/audit/decisions.jsonl
